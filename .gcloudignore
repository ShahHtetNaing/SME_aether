# Google Cloud deployment ignore file
.gcloudignore
.git
.gitignore
.dockerignore

# Dependencies and caches
node_modules/
**/node_modules/
.next/
**/.next/
dist/
**/dist/
coverage/

# Logs and environment
*.log
.env
.env.local
.DS_Store

